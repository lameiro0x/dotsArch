{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch_small",
        "padding": {
            "right": 2
        },
        "color": {
            "1": "37",
            "2": "90"
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":   "90",
            "title":  "37",
            "output": "37"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user": "37",
                "at":   "90",
                "host": "37"
            }
        },
        {
            "type": "separator",
            "string": "────────────────────"
        },
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "cpu",
        "memory",
        "disk",
        {
            "type": "separator",
            "string": "────────────────────"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
